<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Register</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
<div class="container d-flex justify-content-center align-items-center" style="min-height:100vh">
    <div class="card shadow p-5 text-center" style="width:450px">
        <h3 class="mb-2">Create an Account</h3>
        <p class="text-muted mb-4">How would you like to join?</p>

        <a href="/register/customer" class="btn btn-dark btn-lg mb-3 w-100">Register as Customer</a>
        <a href="/register/hotelowner" class="btn btn-outline-dark btn-lg w-100">Register as Business</a>

        <hr>
        <p class="mb-0">Already have an account? <a href="/login">Login</a></p>
    </div>
</div>
